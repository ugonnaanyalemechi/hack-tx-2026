# Web app settings. Copy to .env.local and adjust. NEXT_PUBLIC_* values are
# inlined at build time, so rebuild after changing them.

# "mock" serves fixtures from lib/api/mock-data.ts (no backend needed);
# "live" calls the FastAPI backend. A page load can override it with ?api=live.
NEXT_PUBLIC_API_MODE=mock

# Where the live client sends requests. The default, /api, goes through the
# Next.js rewrite to API_PROXY_TARGET, so the browser needs no CORS.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend origin the /api rewrite forwards to (read when next.config.ts loads).
API_PROXY_TARGET=http://127.0.0.1:8000

# Must match the backend's IDENTITY_HEADER_NAME.
NEXT_PUBLIC_IDENTITY_HEADER_NAME=X-User-Id
